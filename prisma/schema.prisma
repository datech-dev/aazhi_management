// Aazhi Designer Studio — Prisma Schema
// Production-ready database schema for boutique business management

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTHENTICATION & USERS
// ============================================================

enum UserRole {
  OWNER
  ADMIN
  STAFF
  TAILOR
  SALES
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  phone          String?
  hashedPassword String
  role           UserRole  @default(STAFF)
  avatarUrl      String?
  isActive       Boolean   @default(true)
  branchId       String?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  branch             Branch?              @relation(fields: [branchId], references: [id])
  sessions           Session[]
  accounts           Account[]
  assignedLeads      Lead[]               @relation("AssignedStaff")
  assignedOrders     Order[]              @relation("Salesperson")
  tailoredOrders     Order[]              @relation("AssignedTailor")
  productionJobs     ProductionJob[]      @relation("AssignedTailor")
  qualityChecks      QualityCheck[]
  recordedPayments   Payment[]
  conversations      Conversation[]       @relation("AssignedStaff")
  notifications      Notification[]
  auditLogs          AuditLog[]
  customerNotes      CustomerNote[]
  leadActivities     LeadActivity[]
  measurementProfiles MeasurementProfile[] @relation("CreatedByUser")
  rolePermissions    UserPermission[]

  @@index([email])
  @@index([branchId])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// PERMISSIONS
// ============================================================

model Permission {
  id          String @id @default(cuid())
  code        String @unique  // e.g., "customers.view", "orders.create"
  name        String          // Human-readable name
  description String?
  module      String          // e.g., "customers", "orders"

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  role         UserRole
  permissionId String

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@map("role_permissions")
}

model UserPermission {
  id           String  @id @default(cuid())
  userId       String
  permissionId String
  granted      Boolean @default(true)  // false = explicitly denied (override role)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@map("user_permissions")
}

// ============================================================
// BRANCH
// ============================================================

model Branch {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique  // e.g., "AZ-MAS" for Aazhi Mastery branch
  address   String?
  city      String?
  state     String?
  pincode   String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  customers       Customer[]
  orders          Order[]
  leads           Lead[]
  inventoryItems  InventoryItem[]
  conversations   Conversation[]
  numberSequences NumberSequence[]

  @@map("branches")
}

// ============================================================
// CUSTOMERS / CRM
// ============================================================

enum CustomerSource {
  INSTAGRAM
  WHATSAPP
  WALK_IN
  REFERRAL
  PHONE
  WEBSITE
  OTHER
}

model Customer {
  id                    String         @id @default(cuid())
  fullName              String
  preferredName         String?
  phone                 String?
  whatsappNumber        String?
  instagramUsername      String?
  email                 String?
  dateOfBirth           DateTime?
  anniversary           DateTime?
  preferredChannel      CustomerSource @default(WHATSAPP)
  source                CustomerSource @default(WALK_IN)
  totalOrders           Int            @default(0)
  totalLifetimeValue    Decimal        @default(0) @db.Decimal(12, 2)
  lastInteractionAt     DateTime?
  lastOrderAt           DateTime?
  notes                 String?        @db.Text
  isArchived            Boolean        @default(false)
  archivedAt            DateTime?
  branchId              String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  branch              Branch?              @relation(fields: [branchId], references: [id])
  addresses           CustomerAddress[]
  tags                CustomerTag[]
  customerNotes       CustomerNote[]
  leads               Lead[]
  conversations       Conversation[]
  orders              Order[]
  quotations          Quotation[]
  payments            Payment[]
  measurementProfiles MeasurementProfile[]
  deliveries          Delivery[]

  @@index([phone])
  @@index([whatsappNumber])
  @@index([instagramUsername])
  @@index([fullName])
  @@index([email])
  @@index([branchId])
  @@index([isArchived])
  @@map("customers")
}

model CustomerAddress {
  id         String  @id @default(cuid())
  customerId String
  label      String  @default("Home")  // "Home", "Office", "Delivery"
  line1      String
  line2      String?
  city       String
  state      String?
  pincode    String
  isDefault  Boolean @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_addresses")
}

model Tag {
  id        String @id @default(cuid())
  name      String @unique
  color     String @default("#A69B8D")
  createdAt DateTime @default(now())

  customers CustomerTag[]
  leads     LeadTag[]

  @@map("tags")
}

model CustomerTag {
  customerId String
  tagId      String

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
  @@map("customer_tags")
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  userId     String
  content    String   @db.Text
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@map("customer_notes")
}

// ============================================================
// LEADS / ENQUIRIES
// ============================================================

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  QUOTE_SENT
  NEGOTIATION
  CONFIRMED
  LOST
  CONVERTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Lead {
  id              String       @id @default(cuid())
  leadNumber      String       @unique   // LD-2026-0001
  customerId      String
  source          CustomerSource @default(WHATSAPP)
  enquiryMessage  String?      @db.Text
  interestedProductId String?
  estimatedValue  Decimal?     @db.Decimal(12, 2)
  assignedStaffId String?
  status          LeadStatus   @default(NEW)
  priority        Priority     @default(MEDIUM)
  followUpDate    DateTime?
  notes           String?      @db.Text
  convertedAt     DateTime?
  convertedOrderId String?
  branchId        String?
  isArchived      Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  customer         Customer      @relation(fields: [customerId], references: [id])
  interestedProduct Product?     @relation(fields: [interestedProductId], references: [id])
  assignedStaff    User?         @relation("AssignedStaff", fields: [assignedStaffId], references: [id])
  branch           Branch?       @relation(fields: [branchId], references: [id])
  activities       LeadActivity[]
  tags             LeadTag[]
  conversations    Conversation[]

  @@index([status])
  @@index([assignedStaffId])
  @@index([followUpDate])
  @@index([branchId])
  @@index([leadNumber])
  @@map("leads")
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  userId    String?
  action    String   // "status_changed", "note_added", "followed_up"
  details   String?  @db.Text
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@map("lead_activities")
}

model LeadTag {
  leadId String
  tagId  String

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
  @@map("lead_tags")
}

// ============================================================
// CONVERSATIONS & MESSAGING
// ============================================================

enum ChannelType {
  WHATSAPP
  INSTAGRAM
  PHONE
  WALK_IN
  WEBSITE
  EMAIL
  MANUAL
}

enum ConversationStatus {
  NEW
  OPEN
  WAITING_FOR_CUSTOMER
  FOLLOW_UP
  CONVERTED
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model Conversation {
  id              String             @id @default(cuid())
  customerId      String?
  channel         ChannelType
  externalId      String?            // External conversation/thread ID
  assignedStaffId String?
  status          ConversationStatus @default(NEW)
  priority        Priority           @default(MEDIUM)
  subject         String?
  lastMessageAt   DateTime?
  lastMessagePreview String?
  relatedLeadId   String?
  relatedOrderId  String?
  branchId        String?
  isArchived      Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  customer      Customer?     @relation(fields: [customerId], references: [id])
  assignedStaff User?         @relation("AssignedStaff", fields: [assignedStaffId], references: [id])
  relatedLead   Lead?         @relation(fields: [relatedLeadId], references: [id])
  relatedOrder  Order?        @relation(fields: [relatedOrderId], references: [id])
  branch        Branch?       @relation(fields: [branchId], references: [id])
  messages      Message[]

  @@index([customerId])
  @@index([channel])
  @@index([status])
  @@index([lastMessageAt])
  @@index([assignedStaffId])
  @@index([branchId])
  @@map("conversations")
}

model Message {
  id              String           @id @default(cuid())
  conversationId  String
  direction       MessageDirection
  content         String?          @db.Text
  externalId      String?          // Provider message ID
  status          MessageStatus    @default(PENDING)
  senderName      String?
  senderIdentifier String?         // Phone, IG username, etc.
  metadata        Json?            // Provider-specific data
  createdAt       DateTime         @default(now())

  conversation Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments  MessageAttachment[]

  @@index([conversationId])
  @@index([createdAt])
  @@map("messages")
}

model MessageAttachment {
  id         String @id @default(cuid())
  messageId  String
  type       String // "image", "video", "document", "audio"
  url        String?
  filename   String?
  mimeType   String?
  size       Int?
  externalId String? // Provider media ID

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_attachments")
}

model MessageTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique // "order_confirmation", "payment_received"
  channel   ChannelType?     // null = all channels
  subject   String?
  body      String   @db.Text  // "Hello {{customer_name}}, your order {{order_number}} is confirmed."
  variables String[] // ["customer_name", "order_number"]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("message_templates")
}

// ============================================================
// PRODUCTS & CATALOG
// ============================================================

model ProductCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  parentId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryHierarchy")
  products Product[]

  @@map("product_categories")
}

model Product {
  id                String   @id @default(cuid())
  sku               String   @unique
  name              String
  description       String?  @db.Text
  categoryId        String?
  collection        String?
  price             Decimal  @db.Decimal(12, 2)
  costPrice         Decimal? @db.Decimal(12, 2)
  salePrice         Decimal? @db.Decimal(12, 2)
  availableQuantity Int      @default(0)
  lowStockThreshold Int      @default(5)
  fabric            String?
  color             String?
  sizeOptions       String[] // ["S", "M", "L", "XL"]
  isCustomizable    Boolean  @default(false)
  isActive          Boolean  @default(true)
  isArchived        Boolean  @default(false)
  archivedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  category        ProductCategory?  @relation(fields: [categoryId], references: [id])
  images          ProductImage[]
  variants        ProductVariant[]
  orderItems      OrderItem[]
  quotationItems  QuotationItem[]
  leads           Lead[]

  @@index([sku])
  @@index([categoryId])
  @@index([isActive, isArchived])
  @@index([name])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  name      String  // "Red - Large"
  sku       String  @unique
  size      String?
  color     String?
  price     Decimal? @db.Decimal(12, 2) // Override base price
  stock     Int     @default(0)
  isActive  Boolean @default(true)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_variants")
}

// ============================================================
// ORDERS
// ============================================================

enum OrderStatus {
  DRAFT
  CONFIRMED
  MEASUREMENT_PENDING
  CUTTING
  STITCHING
  FINISHING
  QUALITY_CHECK
  ALTERATION
  READY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  ADVANCE_PAID
  PARTIALLY_PAID
  FULLY_PAID
  REFUNDED
}

model Order {
  id                  String        @id @default(cuid())
  orderNumber         String        @unique   // AZ-2026-0001
  customerId          String
  salespersonId       String?
  assignedTailorId    String?
  source              CustomerSource @default(WALK_IN)
  orderDate           DateTime      @default(now())
  expectedDeliveryDate DateTime?
  subtotal            Decimal       @db.Decimal(12, 2) @default(0)
  discountAmount      Decimal       @db.Decimal(12, 2) @default(0)
  discountPercent     Decimal?      @db.Decimal(5, 2)
  taxAmount           Decimal       @db.Decimal(12, 2) @default(0)
  taxPercent          Decimal?      @db.Decimal(5, 2)
  total               Decimal       @db.Decimal(12, 2) @default(0)
  advancePaid         Decimal       @db.Decimal(12, 2) @default(0)
  balance             Decimal       @db.Decimal(12, 2) @default(0)
  status              OrderStatus   @default(DRAFT)
  paymentStatus       PaymentStatus @default(UNPAID)
  priority            Priority      @default(MEDIUM)
  notes               String?       @db.Text
  internalNotes       String?       @db.Text
  quotationId         String?       // If converted from quotation
  isArchived          Boolean       @default(false)
  archivedAt          DateTime?
  branchId            String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  customer         Customer           @relation(fields: [customerId], references: [id])
  salesperson      User?              @relation("Salesperson", fields: [salespersonId], references: [id])
  assignedTailor   User?              @relation("AssignedTailor", fields: [assignedTailorId], references: [id])
  quotation        Quotation?         @relation(fields: [quotationId], references: [id])
  branch           Branch?            @relation(fields: [branchId], references: [id])
  items            OrderItem[]
  statusHistory    OrderStatusHistory[]
  payments         Payment[]
  productionJob    ProductionJob?
  delivery         Delivery?
  conversations    Conversation[]
  measurementProfile MeasurementProfile? @relation("OrderMeasurement")

  @@index([orderNumber])
  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([salespersonId])
  @@index([assignedTailorId])
  @@index([orderDate])
  @@index([expectedDeliveryDate])
  @@index([branchId])
  @@map("orders")
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productId       String?
  description     String  // Snapshot of product name or custom description
  quantity        Int     @default(1)
  unitPrice       Decimal @db.Decimal(12, 2)  // Price at time of order (historical)
  totalPrice      Decimal @db.Decimal(12, 2)
  customizations  String? @db.Text  // JSON or text for custom requirements
  notes           String?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  fromStatus OrderStatus?
  toStatus  OrderStatus
  changedBy String?     // User ID
  notes     String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
  @@map("order_status_history")
}

// ============================================================
// QUOTATIONS
// ============================================================

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

model Quotation {
  id             String          @id @default(cuid())
  quoteNumber    String          @unique  // QT-2026-0001
  customerId     String
  subtotal       Decimal         @db.Decimal(12, 2) @default(0)
  discountAmount Decimal         @db.Decimal(12, 2) @default(0)
  discountPercent Decimal?       @db.Decimal(5, 2)
  taxAmount      Decimal         @db.Decimal(12, 2) @default(0)
  taxPercent     Decimal?        @db.Decimal(5, 2)
  total          Decimal         @db.Decimal(12, 2) @default(0)
  status         QuotationStatus @default(DRAFT)
  validUntil     DateTime?
  notes          String?         @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  customer Customer        @relation(fields: [customerId], references: [id])
  items    QuotationItem[]
  orders   Order[]

  @@index([quoteNumber])
  @@index([customerId])
  @@index([status])
  @@map("quotations")
}

model QuotationItem {
  id          String  @id @default(cuid())
  quotationId String
  productId   String?
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  totalPrice  Decimal @db.Decimal(12, 2)
  notes       String?

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id])

  @@map("quotation_items")
}

// ============================================================
// MEASUREMENTS
// ============================================================

enum MeasurementUnit {
  INCHES
  CENTIMETERS
}

model MeasurementTemplate {
  id        String          @id @default(cuid())
  name      String          @unique  // "Blouse", "Kurti", "Saree Blouse"
  category  String?         // "Tops", "Bottoms", "Dresses"
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  fields   MeasurementField[]
  profiles MeasurementProfile[]

  @@map("measurement_templates")
}

model MeasurementField {
  id          String          @id @default(cuid())
  templateId  String
  name        String          // "Bust"
  key         String          // "bust"
  unit        MeasurementUnit @default(INCHES)
  isRequired  Boolean         @default(true)
  description String?
  sortOrder   Int             @default(0)

  template MeasurementTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, key])
  @@map("measurement_fields")
}

model MeasurementProfile {
  id          String          @id @default(cuid())
  customerId  String
  templateId  String
  unit        MeasurementUnit @default(INCHES)
  version     Int             @default(1)
  notes       String?         @db.Text
  orderId     String?         @unique // Link to specific order
  createdById String
  createdAt   DateTime        @default(now())

  customer  Customer            @relation(fields: [customerId], references: [id])
  template  MeasurementTemplate @relation(fields: [templateId], references: [id])
  createdBy User                @relation("CreatedByUser", fields: [createdById], references: [id])
  order     Order?              @relation("OrderMeasurement", fields: [orderId], references: [id])
  values    MeasurementValue[]

  @@index([customerId])
  @@index([templateId])
  @@map("measurement_profiles")
}

model MeasurementValue {
  id        String  @id @default(cuid())
  profileId String
  fieldKey  String  // Matches MeasurementField.key
  value     Decimal @db.Decimal(6, 2)

  profile MeasurementProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, fieldKey])
  @@map("measurement_values")
}

// ============================================================
// PRODUCTION & QC
// ============================================================

enum ProductionStage {
  MEASUREMENT_PENDING
  CUTTING
  STITCHING
  FINISHING
  QUALITY_CHECK
  ALTERATION
  READY
}

model ProductionJob {
  id                   String          @id @default(cuid())
  orderId              String          @unique
  assignedTailorId     String?
  stage                ProductionStage @default(MEASUREMENT_PENDING)
  priority             Priority        @default(MEDIUM)
  startDate            DateTime?
  expectedCompletionDate DateTime?
  actualCompletionDate DateTime?
  alterationNotes      String?         @db.Text
  notes                String?         @db.Text
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  order           Order                   @relation(fields: [orderId], references: [id])
  assignedTailor  User?                   @relation("AssignedTailor", fields: [assignedTailorId], references: [id])
  statusHistory   ProductionStatusHistory[]
  qualityChecks   QualityCheck[]

  @@index([stage])
  @@index([assignedTailorId])
  @@index([priority])
  @@map("production_jobs")
}

model ProductionStatusHistory {
  id               String          @id @default(cuid())
  productionJobId  String
  fromStage        ProductionStage?
  toStage          ProductionStage
  changedBy        String?
  notes            String?
  createdAt        DateTime        @default(now())

  productionJob ProductionJob @relation(fields: [productionJobId], references: [id], onDelete: Cascade)

  @@index([productionJobId])
  @@map("production_status_history")
}

enum QCResult {
  PASSED
  FAILED
  REQUIRES_ALTERATION
}

model QualityCheck {
  id              String   @id @default(cuid())
  productionJobId String
  checkedById     String
  result          QCResult
  notes           String?  @db.Text
  createdAt       DateTime @default(now())

  productionJob ProductionJob   @relation(fields: [productionJobId], references: [id], onDelete: Cascade)
  checkedBy     User            @relation(fields: [checkedById], references: [id])
  items         QualityCheckItem[]

  @@map("quality_checks")
}

model QualityCheckItem {
  id             String  @id @default(cuid())
  qualityCheckId String
  checkName      String  // "Measurements verified", "Stitching checked"
  passed         Boolean
  notes          String?

  qualityCheck QualityCheck @relation(fields: [qualityCheckId], references: [id], onDelete: Cascade)

  @@map("quality_check_items")
}

// ============================================================
// PAYMENTS
// ============================================================

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CARD
  OTHER
}

enum PaymentType {
  ADVANCE
  PARTIAL
  FINAL
  REFUND
}

model Payment {
  id              String        @id @default(cuid())
  paymentNumber   String        @unique  // PAY-2026-0001
  orderId         String
  customerId      String
  amount          Decimal       @db.Decimal(12, 2)
  method          PaymentMethod
  type            PaymentType   @default(PARTIAL)
  referenceNumber String?
  notes           String?       @db.Text
  recordedById    String
  isVoided        Boolean       @default(false)
  voidedAt        DateTime?
  voidedReason    String?
  createdAt       DateTime      @default(now())

  order      Order    @relation(fields: [orderId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id])
  recordedBy User     @relation(fields: [recordedById], references: [id])
  refunds    PaymentRefund[]

  @@index([paymentNumber])
  @@index([orderId])
  @@index([customerId])
  @@index([createdAt])
  @@map("payments")
}

model PaymentRefund {
  id          String   @id @default(cuid())
  paymentId   String
  amount      Decimal  @db.Decimal(12, 2)
  reason      String?
  processedBy String?
  createdAt   DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("payment_refunds")
}

// ============================================================
// INVENTORY
// ============================================================

enum InventoryItemType {
  PRODUCT
  FABRIC
  LINING
  LACE
  BUTTONS
  ZIPPERS
  HOOKS
  THREADS
  EMBELLISHMENT
  OTHER
}

enum InventoryTransactionType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  RETURN
  DAMAGED
}

model InventoryItem {
  id              String            @id @default(cuid())
  name            String
  sku             String            @unique
  type            InventoryItemType @default(OTHER)
  unit            String            @default("pcs")  // "meters", "pcs", "rolls"
  quantity        Decimal           @db.Decimal(10, 2) @default(0)
  reorderThreshold Decimal          @db.Decimal(10, 2) @default(5)
  costPerUnit     Decimal?          @db.Decimal(12, 2)
  supplierId      String?
  location        String?
  branchId        String?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  supplier     Supplier?              @relation(fields: [supplierId], references: [id])
  branch       Branch?                @relation(fields: [branchId], references: [id])
  transactions InventoryTransaction[]

  @@index([sku])
  @@index([type])
  @@index([branchId])
  @@map("inventory_items")
}

model InventoryTransaction {
  id              String                   @id @default(cuid())
  inventoryItemId String
  type            InventoryTransactionType
  quantity        Decimal                  @db.Decimal(10, 2)
  previousQuantity Decimal                @db.Decimal(10, 2)
  newQuantity     Decimal                  @db.Decimal(10, 2)
  unitCost        Decimal?                 @db.Decimal(12, 2)
  reference       String?   // Order ID, supplier PO, etc.
  notes           String?
  performedBy     String?   // User ID
  createdAt       DateTime  @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([inventoryItemId])
  @@index([type])
  @@index([createdAt])
  @@map("inventory_transactions")
}

model Supplier {
  id            String   @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  whatsapp      String?
  email         String?
  address       String?  @db.Text
  notes         String?  @db.Text
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  inventoryItems InventoryItem[]

  @@map("suppliers")
}

// ============================================================
// DELIVERIES
// ============================================================

enum DeliveryMethod {
  CUSTOMER_PICKUP
  LOCAL_DELIVERY
  COURIER
}

enum DeliveryStatus {
  PENDING
  SCHEDULED
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

model Delivery {
  id              String         @id @default(cuid())
  orderId         String         @unique
  customerId      String
  deliveryMethod  DeliveryMethod @default(CUSTOMER_PICKUP)
  address         String?        @db.Text
  scheduledDate   DateTime?
  deliveredDate   DateTime?
  status          DeliveryStatus @default(PENDING)
  trackingNumber  String?
  courierName     String?
  deliveryNotes   String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  order    Order    @relation(fields: [orderId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([status])
  @@index([scheduledDate])
  @@map("deliveries")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

enum NotificationType {
  NEW_ENQUIRY
  NEW_ORDER
  PAYMENT_RECEIVED
  ORDER_DELAYED
  ORDER_READY
  FOLLOW_UP_DUE
  LOW_STOCK
  DELIVERY_DUE
  NEW_MESSAGE
  GENERAL
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType @default(GENERAL)
  title      String
  message    String
  entityType String?          // "order", "customer", "lead", etc.
  entityId   String?
  isRead     Boolean          @default(false)
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   // "create", "update", "delete", "login", "status_change"
  entityType String   // "customer", "order", "payment"
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// BUSINESS SETTINGS & CONFIG
// ============================================================

model BusinessSettings {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
  group String @default("general")  // "general", "orders", "tax", "communication"

  @@index([group])
  @@map("business_settings")
}

model NumberSequence {
  id         String @id @default(cuid())
  prefix     String // "AZ", "QT", "PAY", "LD"
  year       Int
  lastNumber Int    @default(0)
  branchId   String?

  branch Branch? @relation(fields: [branchId], references: [id])

  @@unique([prefix, year, branchId])
  @@map("number_sequences")
}
